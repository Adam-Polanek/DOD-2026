# Ukázka nastavení. Na Azure se zadává v Settings → Environment variables.
# Hesla vygeneruješ příkazem: openssl rand -hex 16
# Lokálně se .env nenačítá samo – stačí výchozí hodnoty, nebo: node --env-file=.env --experimental-sqlite server/server.js
PORT=3000
ADMIN_TOKEN=zmen-si-toto-heslo
# Z QR_SECRET se počítají kódy v QR. Po vytištění QR už NEMĚNIT!
QR_SECRET=zmen-si-i-toto
DB_PATH=./data/dod.sqlite
